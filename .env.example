# ============================================
# Payment Orchestration Platform — Environment
# ============================================

NODE_ENV=development
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://payments_user:payments_pass@localhost:5432/payments_db

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_LOCK_TTL_MS=30000

# --- RabbitMQ ---
RABBITMQ_URL=amqp://payments_user:payments_pass@localhost:5672
RABBITMQ_PREFETCH=10

# --- API Service ---
API_PORT=3000
API_HOST=0.0.0.0

# --- Worker Service ---
WORKER_CONCURRENCY=10

# --- Gateway Simulator ---
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
GATEWAY_URL=http://localhost:3001

# --- Webhook ---
WEBHOOK_URL=http://localhost:3000/webhooks/payment
WEBHOOK_SECRET=super-secret-webhook-signing-key-change-in-production

# --- Fraud Detection ---
FRAUD_MAX_PAYMENTS_PER_MINUTE=10
FRAUD_MAX_FAILURES_PER_5_MINUTES=5
FRAUD_MAX_AMOUNT=100000

# --- Retry Config ---
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000

# --- Saga Services ---
INVENTORY_SERVICE_URL=http://localhost:3001/inventory
SHIPPING_SERVICE_URL=http://localhost:3001/shipping
