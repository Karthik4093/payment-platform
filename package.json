{
  "name": "payment-orchestration-platform",
  "version": "1.0.0",
  "description": "Production-grade payment orchestration platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "tsx watch src/services/api/index.ts",
    "dev:worker": "tsx watch src/services/worker/index.ts",
    "dev:gateway": "tsx watch src/services/gateway-simulator/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/services/api/index.js",
    "start:worker": "node dist/services/worker/index.js",
    "start:gateway": "node dist/services/gateway-simulator/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --timeout=60000",
    "test:concurrency": "vitest run tests/concurrency --timeout=120000",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@prisma/client": "^5.16.1",
    "amqplib": "^0.10.4",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.19.20",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.0.5",
    "prisma": "^5.16.1",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
